    {
      "ruleId": "monthlyAllowanceYen",
      "versionId": "pre-2024-10",
      "appliesFrom": "2023-12-01",
      "knownFrom": "2023-12-04",
      "knownFromBasis": "snapshot-upper-bound",
      "citations": [
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "中学校卒業まで（15歳の誕生日後の最初の3月31日まで）の児童を養育している方"
        },
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "3歳未満 一律15,000円"
        },
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "3歳以上 小学校修了前 10,000円 （第3子以降は15,000円）"
        },
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "中学生 一律10,000円"
        },
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "※児童を養育している方の所得が所得制限限度額以上、所得上限限度額未満の場合は、特例給付として月額一律5,000円を支給します。"
        },
        {
          "sourceId": "jp-cfa-annai-20231204",
          "snapshotSha256": "5ce93290fec8436a7e2da91654f0ac61a5bef6c6959e868b614137f52c92d9b1",
          "quote": "※「第3子以降」とは、高校卒業まで（18歳の誕生日後の最初の3月31日まで）の養育している児童のうち、3番目以降をいいます。"
        }
      ],
      "expr": {
        "op": "sumOver",
        "list": "children",
        "as": "child",
        "expr": {
          "op": "if",
          "cond": {
            "op": "and",
            "args": [
              {
                "op": "lte",
                "left": {
                  "op": "fact",
                  "path": "$child.birthDate"
                },
                "right": {
                  "op": "period"
                }
              },
              {
                "op": "ageOn",
                "mode": "throughMarch31After",
                "age": 15,
                "birth": {
                  "op": "fact",
                  "path": "$child.birthDate"
                },
                "on": {
                  "op": "period"
                }
              }
            ]
          },
          "then": {
            "op": "if",
            "cond": {
              "op": "gte",
              "left": {
                "op": "fact",
                "path": "recipientIncomeYen"
              },
              "right": {
                "op": "ref",
                "rule": "incomeCapYen"
              }
            },
            "then": {
              "op": "lit",
              "value": 0
            },
            "else": {
              "op": "if",
              "cond": {
                "op": "gte",
                "left": {
                  "op": "fact",
                  "path": "recipientIncomeYen"
                },
                "right": {
                  "op": "ref",
                  "rule": "incomeLimitYen"
                }
              },
              "then": {
                "op": "lit",
                "value": 5000
              },
              "else": {
                "op": "if",
                "cond": {
                  "op": "lt",
                  "left": {
                    "op": "ageOn",
                    "mode": "completedYears",
                    "birth": {
                      "op": "fact",
                      "path": "$child.birthDate"
                    },
                    "on": {
                      "op": "period"
                    }
                  },
                  "right": {
                    "op": "lit",
                    "value": 3
                  }
                },
                "then": {
                  "op": "lit",
                  "value": 15000
                },
                "else": {
                  "op": "if",
                  "cond": {
                    "op": "and",
                    "args": [
                      {
                        "op": "ageOn",
                        "mode": "throughMarch31After",
                        "age": 12,
                        "birth": {
                          "op": "fact",
                          "path": "$child.birthDate"
                        },
                        "on": {
                          "op": "period"
                        }
                      },
                      {
                        "op": "gte",
                        "left": {
                          "op": "add",
                          "args": [
                            {
                              "op": "lit",
                              "value": 1
                            },
                            {
                              "op": "countWhere",
                              "list": "children",
                              "as": "other",
                              "where": {
                                "op": "and",
                                "args": [
                                  {
                                    "op": "lt",
                                    "left": {
                                      "op": "fact",
                                      "path": "$other.birthDate"
                                    },
                                    "right": {
                                      "op": "fact",
                                      "path": "$child.birthDate"
                                    }
                                  },
                                  {
                                    "op": "and",
                                    "args": [
                                      {
                                        "op": "lte",
                                        "left": {
                                          "op": "fact",
                                          "path": "$other.birthDate"
                                        },
                                        "right": {
                                          "op": "period"
                                        }
                                      },
                                      {
                                        "op": "ageOn",
                                        "mode": "throughMarch31After",
                                        "age": 18,
                                        "birth": {
                                          "op": "fact",
                                          "path": "$other.birthDate"
                                        },
                                        "on": {
                                          "op": "period"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        "right": {
                          "op": "lit",
                          "value": 3
                        }
                      }
                    ]
                  },
                  "then": {
                    "op": "lit",
                    "value": 15000
                  },
                  "else": {
                    "op": "lit",
                    "value": 10000
                  }
                }
              }
            }
          },
          "else": {
            "op": "lit",
            "value": 0
          }
        }
      }
    },
